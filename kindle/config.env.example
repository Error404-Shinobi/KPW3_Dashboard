# KPW3 看板 —— 设备端配置
#
# 用法：把本文件复制成 config.env，放到 Kindle 的 /mnt/us/dashboard/ 下
#       （插上电脑后就是 F:\dashboard\config.env）。
#       之后每次 `;log runme` 都会自动读它，不用再碰。
#
# 格式：每行 KEY=VALUE，# 开头是注释。
#       等号两侧可以有空格，值两边可以加引号，都会正确识别。
#       Windows 记事本存出来的 CRLF 换行已做兼容。

# ── 必填：服务端地址 ─────────────────────────────────────────
# 你的看板服务器地址，**要带端口**。
# 注意：别用域名 —— 实测「域名+非标准端口」很容易被中间层拦截
#       （302 到一个 webblock 页面），IP 直连最稳。
DASH_SERVER=http://YOUR_SERVER_IP:8787

# ── 必填（如果服务端开了 token）：访问令牌 ────────────────────
# 服务端设了 DASH_ACCESS_TOKEN 时，这里必须填一样的值。
#
# 不填会怎样：看板**照常显示**（拉图走 URL 参数），
#   只是网页上那个「退出看板」按钮点了没反应（401）。
#
# 服务端上怎么拿：
#   grep DASH_ACCESS_TOKEN server/.env
DASH_ACCESS_TOKEN=

# ── 可选：刷新与省电（不填就用括号里的默认值）────────────────
#
# DASH_INTERVAL=600           （600）刷新间隔秒数。
#                             插电常显建议 300，纯电池 600~1800
# DASH_FULL_EVERY=12          （12）每几轮做一次整屏清白，用来压残影
# DASH_CONTROL=1              （1）是否每轮问服务端「要不要退出」；
#                             设 0 可省一次网络请求
# DASH_WIFI_TOGGLE=0          （0）设 1 只在拉图时开 WiFi，拉完关掉
#                             —— 电池供电用，代价是每轮多等 WiFi 起来
#
# ── 可选：网络容错 ──────────────────────────────────────────
#
# DASH_WIFI_WAIT_MAX=30       （30）等网络就绪的上限秒数。
#                             探到通就立刻走，不通最多等这么久
# DASH_WIFI_RESTART_AFTER=3   （3）连续几轮网络故障后自动 toggle 无线
#                             （关 5 秒→开 5 秒）；设 0 关闭这个自愈
# DASH_FETCH_TIMEOUT=15       （15）拉图的 HTTP 超时秒数。
#                             网络不通时多久放弃，别设太大
