# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交

# MiniMax 的 Subscription Key（Token Plan 订阅凭证）
# 注意：不是平时调模型用的 pay-as-you-go API Key
MINIMAX_SUBSCRIPTION_KEY=

# 彩云天气的 token（可选）
# 只在 config.yaml 里把 weather.provider 改成 caiyun 时才需要。
# token 从 https://dashboard.caiyunapp.com/ 拿，免费版每天 1000 次。
CAIYUN_TOKEN=
